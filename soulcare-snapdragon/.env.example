# SoulCare Desktop — environment template (safe to commit)

SOULCARE_DEMO=1
# Set to 1 ONLY on non-Snapdragon machines for hackathon demos.
# On Snapdragon HP PCs keep this 0 — all inference stays on-device.
SOULCARE_CLOUD_FALLBACK=0

HOST=0.0.0.0
PORT=8000
SOULCARE_ACCEL=npu

# Optional cloud fallbacks (never commit real keys)
GROQ_API_KEY=
VOICE_AGENT_API_KEY=

# Qualcomm AI Hub / local model toggles
FORCE_WHISPER=0
FORCE_DISTILBERT=0
FORCE_PHI35=0
FORCE_VAD=0
WHISPER_MODEL=small
PHI35_MODEL=microsoft/Phi-3.5-mini-instruct
DISTILBERT_MODEL=distilbert-base-uncased
