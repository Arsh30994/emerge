# SoulCare Desktop — environment template (safe to commit)

SOULCARE_DEMO=1
# Privacy-first: cloud fallbacks are disabled in the product path.
SOULCARE_CLOUD_FALLBACK=0

HOST=0.0.0.0
PORT=8000
SOULCARE_ACCEL=npu

# Qualcomm AI Hub / local model toggles (enable on Snapdragon HP PC)
FORCE_WHISPER=0
FORCE_DISTILBERT=0
FORCE_PHI35=0
FORCE_VAD=0
WHISPER_MODEL=small
PHI35_MODEL=microsoft/Phi-3.5-mini-instruct
DISTILBERT_MODEL=distilbert-base-uncased
