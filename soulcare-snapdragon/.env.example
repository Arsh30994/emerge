# SoulCare Desktop — environment template
# Copy to .env if desired (optional; env vars also work inline)

SOULCARE_DEMO=1
HOST=0.0.0.0
PORT=8000

# Hardware preference: npu | gpu | cpu
SOULCARE_ACCEL=cpu

# Enable real local models (requires extra packages + downloads)
FORCE_WHISPER=0
WHISPER_MODEL=base
FORCE_TONE=0
FORCE_PHI3=0
# PHI3_MODEL=microsoft/Phi-3-mini-4k-instruct
